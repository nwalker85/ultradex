# Dex API Configuration
DEX_API_KEY=your_dex_api_key_here

# Anthropic/Claude API Configuration
CLAUDE_API_KEY=your_anthropic_api_key_here

# Private control-surface authentication (source these from 1Password)
ULTRADEX_API_TOKEN=your_private_operator_token_here
ULTRADEX_OPERATOR_ID=operator:your_pairwise_id

# Database Configuration
DATABASE_URL=postgresql://hrafngrima:hrafngrima_dev_password@localhost:5432/hrafngrima
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

# Governed job-search accountability receipts (source from 1Password)
ULTRADEX_ACCOUNTABILITY_HMAC_KEY=base64url_32_byte_secret
ULTRADEX_RECEIPT_ED25519_PRIVATE_KEY=base64url_32_byte_private_key
ULTRADEX_RECEIPT_KEY_ID=pairwise:v1:registered_receipt_key_id
ULTRADEX_EXECUTOR_PAIRWISE_ID=pairwise:v1:registered_executor_id
ULTRADEX_SERVICE_VERSION=2.0.0
ULTRADEX_DEPLOYMENT_SHA=git_commit_sha
ULTRADEX_ENVIRONMENT=local

# Server Configuration
HOST=0.0.0.0
PORT=8000
